"""Smoke tests for the generated Python wrapper and compiled Rust hooks.

Add decision and failure-mode tests as the plugin gains behavior. Test core
algorithms in Rust; keep Python tests focused on the packaging/hook boundary.
"""

import pytest

from cpex.framework import PluginConfig
from {{ module_name }} import {{ plugin_class }}


@pytest.mark.asyncio
@pytest.mark.parametrize("hook", {{ hooks }})
async def test_hook_allows_request(hook: str) -> None:
    plugin = {{ plugin_class }}(
        PluginConfig(
            name="{{ plugin_name }}",
            kind="{{ module_name }}.{{ plugin_name }}.{{ plugin_class }}",
            hooks={{ hooks }},
            config={},
        )
    )
    result = await getattr(plugin, hook)({"value": "example"}, None)
    assert result.continue_processing is True
    assert result.violation is None
    assert "error" not in (result.metadata or {})
